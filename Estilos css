/* hearder*/

header {
    background-color: #f7941d;
    text-align: center;
    padding: 25px;
    border-radius: 40px;
    margin-bottom: 20px;
}

header h1 {
        font-size: 35px;
}
header p {
    font-size: 18px;
   
}

/* nav */

nav {
    background-color: #00aa1c;
    padding: 15px;
    border-radius: 20px;
    margin-bottom: 20px;
    text-align:center ;
}
nav ul {
    list-style: none;
}
nav ul li {
    display: inline-block;
    margin: 0 15px;
}

nav ul li a {
    text-decoration: none;
    color: blueviolet;
    font-weight: bold;
}

/* contenido principal   */

.contenido-central {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
}


section {
    background-color: #f71da3;
    flex: 3;
    padding: 20px;
    border-radius: 10px;
}

section h2 {
    color: rgb(61, 43, 221);
    text-align: center;
    margin-bottom: 15px;
}

article {
    background-color: #bb0876;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 15px;
    text-align: center;
}
article h3 {
    margin-bottom: 10px;
}

/* aside */
aside {
    background-color: #4d940a;
    flex: 1;
    padding: 20px;
    border-radius: 20px;
    text-align: center;
}
aside h3 {
    margin-bottom: 15px;
}
/* buscador */
.buscador {
      margin-bottom: 20px;
}

.buscador h4   {
    margin-bottom: 10px;
}
.buscador input{
    width: 90%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 10px;
    border: none;
}
/* footer o cuadro inferior */
footer {
    background-color: #ce0202;
    padding: 15px;
    border-radius: 20px;
    margin-bottom: 20px;
    text-align:center ;
}
